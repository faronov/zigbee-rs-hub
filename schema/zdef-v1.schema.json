{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faronov/zigbee-rs-hub/schema/zdef-v1.schema.json",
  "title": "zdef v1 device definition (source form)",
  "description": "Generated by `zdefc schema` from the zdef tables; see docs/device-support.md sections 6-8, 12, 13.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "zdef": {
      "const": 1
    },
    "zdef_fragment": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9._/-]{3,64}$"
    },
    "revision": {
      "$ref": "#/$defs/u32"
    },
    "vendor": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "mfr": {
      "$ref": "#/$defs/u16"
    },
    "match": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "manufacturer": {
            "$ref": "#/$defs/name_match"
          },
          "model": {
            "$ref": "#/$defs/name_match"
          },
          "mfr_code": {
            "$ref": "#/$defs/u16"
          },
          "app_version": {
            "$ref": "#/$defs/range"
          },
          "stack_version": {
            "$ref": "#/$defs/range"
          },
          "hw_version": {
            "$ref": "#/$defs/range"
          },
          "sw_build": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "prefix": {
                    "type": "string"
                  }
                },
                "required": ["prefix"]
              }
            ]
          },
          "date_code": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "prefix": {
                    "type": "string"
                  }
                },
                "required": ["prefix"]
              }
            ]
          },
          "power": {
            "enum": ["mains", "battery"]
          },
          "logical_type": {
            "enum": ["coordinator", "router", "end_device"]
          },
          "x-priority": {
            "type": "integer"
          },
          "x-white-label": {
            "type": "boolean"
          },
          "endpoints": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^(0|-?[1-9][0-9]*|0x[0-9a-fA-F]+)$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "profile": {
                  "$ref": "#/$defs/u16"
                },
                "device_id": {
                  "$ref": "#/$defs/u16"
                },
                "in": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/u16"
                  }
                },
                "out": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/u16"
                  }
                }
              }
            }
          },
          "gp": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "device_id": {
                "$ref": "#/$defs/u8"
              },
              "manufacturer_id": {
                "$ref": "#/$defs/u16"
              },
              "model_id": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/u16"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "value": {
                        "$ref": "#/$defs/u16"
                      },
                      "mask": {
                        "$ref": "#/$defs/u16"
                      }
                    },
                    "required": ["value", "mask"]
                  }
                ]
              },
              "src_id": {
                "type": "array",
                "prefixItems": [
                  {
                    "$ref": "#/$defs/u32"
                  },
                  {
                    "$ref": "#/$defs/u32"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "ieee": {
                "type": "string",
                "pattern": "^[0-9a-fA-F:]{1,23}$"
              },
              "commands": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/u8"
                }
              },
              "clusters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "server": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/u16"
                    }
                  },
                  "client": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/u16"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "white_label": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vendor": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "manufacturer": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "model_id": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "sw_build": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "requires": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "expr-v1",
          "tuya",
          "gp",
          "struct.zcl_tagged",
          "codec.tuya_schedule_day",
          "codec.tuya_schedule_week",
          "codec.bcd_time",
          "codec.hhmm",
          "codec.ascii",
          "codec.utf16be_hex",
          "codec.bitmap_flags",
          "match.date_code",
          "template.hue_light",
          "template.lumi",
          "template.tuya",
          "template.tuya_metering_zero_debounce",
          "wasm"
        ]
      }
    },
    "priority": {
      "type": "integer",
      "minimum": -1000,
      "maximum": 1000
    },
    "self_description": {
      "enum": ["ignore", "under", "over"]
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "power": {
          "enum": ["mains", "battery", "energy_harvesting"]
        },
        "sleepy": {
          "type": "boolean"
        },
        "battery": {
          "oneOf": [
            {
              "enum": ["3V_2100", "3V_1500_2800", "CR2032"]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "voltage_to_percent": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "$ref": "#/$defs/u32"
                    },
                    {
                      "$ref": "#/$defs/u32"
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": ["voltage_to_percent"]
            }
          ]
        },
        "checkin_s": {
          "$ref": "#/$defs/u32"
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout_s": {
              "$ref": "#/$defs/u32"
            }
          }
        },
        "ota": {
          "type": "boolean"
        }
      }
    },
    "generic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exclude": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "patch": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/part"
          }
        },
        "disable": {
          "type": "boolean"
        },
        "only_endpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 254
          }
        }
      }
    },
    "endpoints": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(0|-?[1-9][0-9]*|0x[0-9a-fA-F]+)$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "tuya": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time_sync": {
          "oneOf": [
            {
              "enum": ["off", "1970", "2000"]
            },
            {
              "const": 1970
            },
            {
              "const": 2000
            }
          ]
        },
        "force_time_sync_s": {
          "$ref": "#/$defs/u32"
        },
        "magic_packet": {
          "type": "boolean"
        },
        "query": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "enum": ["configure", "announce"]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "interval_s": {
                        "$ref": "#/$defs/u32"
                      }
                    },
                    "required": ["interval_s"]
                  }
                ]
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "interval_s": {
                  "$ref": "#/$defs/u32"
                }
              },
              "required": ["interval_s"]
            }
          ]
        },
        "bind_basic": {
          "type": "boolean"
        },
        "gateway_status": {
          "type": "boolean"
        },
        "send": {
          "enum": ["dataRequest", "sendData"]
        },
        "mcu_version": {
          "type": "boolean"
        },
        "optimistic": {
          "type": "boolean"
        },
        "dedup": {
          "type": "boolean"
        }
      }
    },
    "configure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bind": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ep": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 254
                  },
                  "clusters": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/u16"
                    }
                  }
                },
                "required": ["clusters"]
              }
            },
            "required": ["bind"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "write": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cluster": {
                    "$ref": "#/$defs/u16"
                  },
                  "attr": {
                    "$ref": "#/$defs/u16"
                  },
                  "type": {
                    "$ref": "#/$defs/zcl_type"
                  },
                  "value": {
                    "$ref": "#/$defs/scalar"
                  },
                  "mfr": {
                    "$ref": "#/$defs/u16"
                  },
                  "ep": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 254
                  }
                },
                "required": ["cluster", "attr", "type", "value"]
              }
            },
            "required": ["write"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "read": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ep": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 254
                  },
                  "cluster": {
                    "$ref": "#/$defs/u16"
                  },
                  "attrs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/u16"
                    }
                  },
                  "mfr": {
                    "$ref": "#/$defs/u16"
                  }
                },
                "required": ["cluster", "attrs"]
              }
            },
            "required": ["read"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "report": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ep": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 254
                  },
                  "cluster": {
                    "$ref": "#/$defs/u16"
                  },
                  "attr": {
                    "$ref": "#/$defs/u16"
                  },
                  "type": {
                    "$ref": "#/$defs/zcl_type"
                  },
                  "report": {
                    "$ref": "#/$defs/report"
                  },
                  "mfr": {
                    "$ref": "#/$defs/u16"
                  }
                },
                "required": ["cluster", "attr", "type", "report"]
              }
            },
            "required": ["report"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cmd": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cluster": {
                    "$ref": "#/$defs/u16"
                  },
                  "id": {
                    "$ref": "#/$defs/u8"
                  },
                  "mfr": {
                    "$ref": "#/$defs/u16"
                  },
                  "ep": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 254
                  },
                  "payload": {
                    "$ref": "#/$defs/expr"
                  }
                },
                "required": ["cluster", "id"]
              }
            },
            "required": ["cmd"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "group": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ep": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 254
                  },
                  "group": {
                    "$ref": "#/$defs/u16"
                  }
                },
                "required": ["group"]
              }
            },
            "required": ["group"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "checkin": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "interval_qs": {
                    "$ref": "#/$defs/u32"
                  }
                },
                "required": ["interval_qs"]
              }
            },
            "required": ["checkin"]
          }
        ]
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "gp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "security_min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "report_interval_s": {
          "$ref": "#/$defs/u32"
        },
        "ignore_commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/u8"
          }
        }
      }
    },
    "ignore": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ep": {
            "type": "integer",
            "minimum": 1,
            "maximum": 254
          },
          "cluster": {
            "$ref": "#/$defs/u16"
          },
          "cmd": {
            "$ref": "#/$defs/u8"
          }
        },
        "required": ["cluster"]
      }
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": ["hue_light", "lumi", "tuya", "tuya_metering_zero_debounce"]
          },
          "params": {
            "type": "object"
          }
        },
        "required": ["name"]
      }
    },
    "x-wasm": {
      "type": "object"
    },
    "x-partial": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "required": ["zdef", "id", "revision", "vendor", "model", "match"],
      "not": {
        "required": ["zdef_fragment"]
      }
    },
    {
      "required": ["zdef_fragment"],
      "not": {
        "anyOf": [
          {
            "required": ["zdef"]
          },
          {
            "required": ["id"]
          },
          {
            "required": ["match"]
          },
          {
            "required": ["white_label"]
          },
          {
            "required": ["tuya"]
          },
          {
            "required": ["gp"]
          }
        ]
      }
    }
  ],
  "$defs": {
    "u8": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "u16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "expr": {
      "type": ["string", "number", "boolean"]
    },
    "scalar": {
      "type": ["null", "boolean", "number", "string"]
    },
    "named_exprs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/expr"
      }
    },
    "zcl_type": {
      "enum": [
        "data8",
        "data16",
        "data24",
        "data32",
        "bool",
        "map8",
        "map16",
        "map24",
        "map32",
        "u8",
        "u16",
        "u24",
        "u32",
        "u40",
        "u48",
        "u56",
        "u64",
        "i8",
        "i16",
        "i24",
        "i32",
        "i40",
        "i48",
        "i56",
        "i64",
        "enum8",
        "enum16",
        "f16",
        "f32",
        "f64",
        "ostr",
        "str",
        "ostr16",
        "str16",
        "tod",
        "date",
        "utc",
        "cluster_id",
        "attr_id",
        "ieee",
        "key128"
      ]
    },
    "tuya_dp": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/u8"
        },
        {
          "enum": ["raw", "bool", "value", "string", "enum", "bitmap"]
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "report": {
      "oneOf": [
        {
          "const": "off"
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/u16"
            },
            {
              "$ref": "#/$defs/u16"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2,
          "maxItems": 3
        }
      ]
    },
    "device_class": {
      "enum": [
        "temperature",
        "humidity",
        "pressure",
        "illuminance",
        "battery",
        "voltage",
        "current",
        "power",
        "energy",
        "power_factor",
        "frequency",
        "carbon_dioxide",
        "carbon_monoxide",
        "pm25",
        "pm10",
        "pm1",
        "volatile_organic_compounds",
        "moisture",
        "occupancy",
        "motion",
        "door",
        "window",
        "opening",
        "smoke",
        "gas",
        "problem",
        "tamper",
        "vibration",
        "enum",
        "duration",
        "distance",
        "signal_strength",
        "button",
        "restart",
        "identify",
        "update",
        "outlet",
        "switch",
        "connectivity",
        "plug",
        "running",
        "safety",
        "sound",
        "lock",
        "cold",
        "heat",
        "light",
        "presence",
        "water",
        "blind",
        "curtain",
        "shade",
        "shutter",
        "garage",
        "gate",
        "awning",
        "damper",
        "doorbell",
        "water_heater",
        "atmospheric_pressure",
        "absolute_humidity",
        "apparent_power",
        "aqi",
        "area",
        "blood_glucose_concentration",
        "conductivity",
        "data_rate",
        "data_size",
        "date",
        "energy_distance",
        "energy_storage",
        "irradiance",
        "monetary",
        "nitrogen_dioxide",
        "nitrogen_monoxide",
        "nitrous_oxide",
        "ozone",
        "ph",
        "pm4",
        "precipitation",
        "precipitation_intensity",
        "reactive_energy",
        "reactive_power",
        "sound_pressure",
        "speed",
        "sulphur_dioxide",
        "timestamp",
        "volatile_organic_compounds_parts",
        "volume",
        "volume_flow_rate",
        "volume_storage",
        "weight",
        "wind_direction",
        "wind_speed",
        "battery_charging",
        "garage_door",
        "moving",
        "firmware"
      ]
    },
    "unit": {
      "enum": [
        "°C",
        "°F",
        "K",
        "%",
        "hPa",
        "kPa",
        "Pa",
        "lx",
        "ppm",
        "ppb",
        "µg/m³",
        "W",
        "kW",
        "Wh",
        "kWh",
        "V",
        "mV",
        "A",
        "mA",
        "Hz",
        "VA",
        "var",
        "s",
        "min",
        "h",
        "d",
        "ms",
        "m",
        "cm",
        "mm",
        "km",
        "m³",
        "L",
        "m³/h",
        "L/min",
        "dB",
        "dBm",
        "mired",
        "°",
        "mW",
        "MW",
        "GW",
        "MWh",
        "GWh",
        "varh",
        "kvar",
        "kvarh",
        "kVA",
        "kV",
        "µV",
        "µA",
        "kHz",
        "MHz",
        "GHz",
        "µs",
        "w",
        "m/s",
        "km/h",
        "mph",
        "kn",
        "ft",
        "in",
        "yd",
        "mi",
        "µm",
        "g",
        "kg",
        "mg",
        "µg",
        "oz",
        "lb",
        "st",
        "mL",
        "gal",
        "fl. oz.",
        "ft³",
        "CCF",
        "gal/min",
        "ft³/min",
        "m³/s",
        "mm/h",
        "in/h",
        "mm/d",
        "in/d",
        "mbar",
        "bar",
        "psi",
        "inHg",
        "mmHg",
        "cbar",
        "µS/cm",
        "mS/cm",
        "S/cm",
        "lm",
        "W/m²",
