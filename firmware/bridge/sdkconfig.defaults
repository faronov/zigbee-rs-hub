# Thread BR board, early sample: 4 MB flash (Zbit 5e4016); retail boards have 8 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=6144

# Logs go to UART0 (S3 GPIO43/44 on J4). The native USB PHY belongs to TinyUSB
# while the bridge runs, so no USB-Serial-JTAG console; but the USJ peripheral
# itself stays enabled for the recovery paths (see README).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=y

# H2 UART RX path: ISR in IRAM, keeps up while flash is busy.
CONFIG_UART_ISR_IN_IRAM=y

# TinyUSB: two CDC-ACM ports (0 = transparent H2 bridge, 1 = control console).
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=2
CONFIG_TINYUSB_CDC_RX_BUFSIZE=4096
CONFIG_TINYUSB_CDC_TX_BUFSIZE=4096
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="zigbee-rs-hub"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Thread BR H2 bridge"
CONFIG_TINYUSB_DESC_CDC_STRING="H2 bridge"

CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="tbr-bridge-0.1.3"
