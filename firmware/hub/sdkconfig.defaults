# Applied after firmware/bridge/sdkconfig.defaults (same board, same USB
# identity, so the bridge mode looks exactly like tbr-bridge to the host).
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="tbr-hub-0.1.2"

# WebSocket JSON API (esp_http_server).
CONFIG_HTTPD_WS_SUPPORT=y

# Core dumps to the `coredump` partition (dev and production tables):
# hub-mode logs go to UART0, which the lab host cannot see.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
# The crashed task first, then a few more: the whole task set does not fit
# the 64 KiB partition.
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=4

# PSRAM (ESP32-S3-WROOM-1 R2: 2 MB quad) for the heap: the application does
# not fit the internal RAM. Thread stacks stay internal (flash writes from
# those threads). Boots without PSRAM too (then RAM is tight).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Internal RAM without PSRAM (4 MB sample): fewer Wi-Fi buffers, no A-MPDU,
# Wi-Fi/FreeRTOS/heap code in flash instead of IRAM (IRAM and DRAM share
# the S3's SRAM). The hub's traffic is small WebSocket frames.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=12
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
