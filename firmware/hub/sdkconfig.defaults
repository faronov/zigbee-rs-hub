# Applied after firmware/bridge/sdkconfig.defaults (same board, same USB
# identity, so the bridge mode looks exactly like tbr-bridge to the host).
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="tbr-hub-0.2.0"

# WebSocket JSON API (esp_http_server).
CONFIG_HTTPD_WS_SUPPORT=y

# Core dumps to the `coredump` partition (dev and production tables):
# hub-mode logs go to UART0, which the lab host cannot see.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
# The crashed task first, then a few more: the whole task set does not fit
# the 64 KiB partition.
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=4

# PSRAM for the heap. ESP-IDF fixes the PSRAM mode at build time: this
# file builds the quad variant (N4R2/N8R2 modules, S3FH4R2); sdkconfig.octal
# adds the octal one (N4R8/N8R8/N16R8, e.g. the lab BR board). The other
# variant, or a module without PSRAM, boots without PSRAM (IGNORE_NOTFOUND).
# Rust allocations prefer PSRAM (firmware/hub/src/alloc.rs); C mallocs above
# 1 KiB and the Wi-Fi/lwIP buffers too. Thread stacks stay internal (flash
# writes from those threads).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Internal RAM without PSRAM (4 MB sample): fewer Wi-Fi buffers, no A-MPDU,
# Wi-Fi/FreeRTOS/heap code in flash instead of IRAM (IRAM and DRAM share
# the S3's SRAM). The hub's traffic is small WebSocket frames.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=12
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y

# Per-task CPU use for the `hub cpu` console command.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Size, no feature lost: C printf family from ROM ("nano": no 64-bit
# integer or float conversions; only ESP-IDF's own UART0 log lines use the
# C formatter, Rust formats its own), −27 KB; no IPv6 (the hub never gets
# an IPv6 address: no link-local is created, no SLAAC), −20 KB and 1.5 KB
# of RAM.
CONFIG_LIBC_NEWLIB_NANO_FORMAT=y
CONFIG_LWIP_IPV6=n

# ESP-IDF assert() without its message: abort() at the failing PC (the
# core dump and the UART0 backtrace still locate it with the ELF). Saves
# 49 KB of flash and 5 KB of internal RAM (IRAM and DRAM strings).
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# SNTP: up to three servers (hub/time/set).
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# MQTT bridge (esp-mqtt): plain TCP only. The hub does no TLS, so the SSL
# and WebSocket transports stay out of the image.
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=n

# lwIP's tcpip task also runs SNTP and its DNS lookups: 780 B of the
# default 3 KiB were left on the lab board (hub 0.2.0); 1 KiB more margin.
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096

# PTA (Wi-Fi / 802.15.4 coexistence) leader for the H2 NCP (ZRHP spec 11.5,
# `src/pta.rs`): ESP-IDF's external-coexistence GPIO API. Requires Bluetooth
# off (the hub has none).
CONFIG_ESP_COEX_EXTERNAL_COEXIST_ENABLE=y
