# Common to the gateway boards (firmware/donglem, firmware/s3-mg24); each
# board's own sdkconfig.defaults is applied after this file.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=6144
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# NCP UART RX path: ISR in IRAM, keeps up while flash is busy.
CONFIG_UART_ISR_IN_IRAM=y

# WebSocket JSON API (esp_http_server).
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# PSRAM (2 MB quad on both boards): heap for everything above 4 KiB; thread
# stacks stay internal (they write flash). Wi-Fi/lwIP buffers may use PSRAM;
# 48 KiB of internal RAM stays reserved for DMA (EMAC, UART) and stacks.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
