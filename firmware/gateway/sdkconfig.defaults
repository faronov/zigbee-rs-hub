# Common to the gateway boards (firmware/donglem); a board's own
# sdkconfig.defaults is applied after this file. Set for the product
# feature set (docs/dongle-max.md): hub application, web UI + WebSocket API,
# MQTT, Zigbee device OTA, self-update, Ethernet + Wi-Fi; the bring-up
# image already builds with it.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=6144
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# No Bluetooth: not in the feature set; the controller's DRAM stays with
# the heap.
CONFIG_BT_ENABLED=n

# NCP UART RX path: ISR in IRAM, keeps up while flash is busy.
CONFIG_UART_ISR_IN_IRAM=y

# `cpu` and `atomics` on the console (the source of firmware/hub/src/cpu.rs).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# PSRAM for the heap, as in firmware/hub: Rust allocations prefer PSRAM
# (firmware/hub/src/alloc.rs, shared), C mallocs above 1 KiB and the
# Wi-Fi/lwIP buffers too; thread stacks stay internal. Without PSRAM the
# image still boots (IGNORE_NOTFOUND).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Core dumps to the `coredump` partition of the product table; on the
# stock table (bring-up) there is none and only the panic recorder (RTC
# memory, `info`) keeps the last panic.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=4

# Self-update with a trial boot: a new image starts PENDING_VERIFY and is
# confirmed once it runs (zrh_gateway::run). Whether the stock bootloader
# was built with rollback support is not known (its log is silent); without
# it a new image simply boots, without the automatic fallback.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# While the image may run on the stock table, the default NVS partition is
# shared with the stock firmware's data: the firmware keeps its settings in
# its own namespace (`zrh`) and nothing else writes NVS (Wi-Fi without NVS
# storage, the PHY calibrates at every boot). On the product table, NVS is
# the hub's own and PHY data storage can be turned on.
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n

# Web UI and WebSocket JSON API (esp_http_server), as firmware/hub.
CONFIG_HTTPD_WS_SUPPORT=y
# MQTT bridge (esp-mqtt): plain TCP only, as firmware/hub.
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=n
# SNTP: up to three servers; lwIP's tcpip task also runs SNTP and DNS.
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096

# Internal RAM is the classic ESP32's limit (docs/dongle-max.md, RAM
# budget), as in firmware/hub: no IPv6 (no address is ever configured), C
# printf from ROM without 64-bit/float conversions, assert() without its
# message (abort at the failing PC; the ELF locates it; ~5 KB of DRAM).
CONFIG_LWIP_IPV6=n
CONFIG_LIBC_NEWLIB_NANO_FORMAT=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
